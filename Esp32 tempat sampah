void bukaTempatSampah() {
  servoTutup.write(SUDUT_BUKA);
  statusTerbuka = true;
  waktuTerakhirBuka = millis();
  Serial.println("Tempat sampah DIBUKA");
}

void tutupTempatSampah() {
  servoTutup.write(SUDUT_TUTUP);
  statusTerbuka = false;
  Serial.println("Tempat sampah DITUTUP");
}

void handleRoot() {
  server.send(200, "text/html", index_html);
}

void handleAksi() {
  if (server.hasArg("cmd")) {
    String cmd = server.arg("cmd");
    if (cmd == "buka") {
      bukaTempatSampah();
      server.send(200, "text/plain", "TERBUKA");
    } else if (cmd == "tutup") {
      tutupTempatSampah();
      server.send(200, "text/plain", "TERTUTUP");
    } else {
      server.send(400, "text/plain", "Perintah tidak valid");
    }
  }
}

void handleStatus() {
  server.send(200, "text/plain", statusTerbuka ? "TERBUKA" : "TERTUTUP");
}

void setup() {
  Serial.begin(115200);

  servoTutup.attach(servoPin);
  tutupTempatSampah();

  WiFi.begin(ssid, password);
  Serial.print("Menghubungkan ke WiFi");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("\nTerhubung! Buka IP berikut di browser:");
  Serial.println(WiFi.localIP());

  server.on("/", handleRoot);
  server.on("/aksi", handleAksi);
  server.on("/status", handleStatus);
  server.begin();
}

void loop() {
  server.handleClient();

  if (statusTerbuka && (millis() - waktuTerakhirBuka >= WAKTU_AUTO_TUTUP)) {
    tutupTempatSampah();
  }
}
