#include <WiFi.h>
#include <WebServer.h>
#include <ESP32Servo.h>

// Ganti dengan nama WiFi dan password Anda (Harus 2.4 GHz)
const char* ssid = "NAMA_WIFI_ANDA";
const char* password = "PASSWORD_WIFI_ANDA";

Servo servoTutup;
const int servoPin = 13; // Kabel sinyal servo ke GPIO 13

// Pengaturan sudut buka dan tutup (sesuaikan dengan mekanik tutup sampah Anda)
const int SUDUT_TUTUP = 0;
const int SUDUT_BUKA = 90;

// Pengaturan tutup otomatis (5000 ms = 5 detik)
const unsigned long WAKTU_AUTO_TUTUP = 5000; 
unsigned long waktuTerakhirBuka = 0;
bool statusTerbuka = false;

WebServer server(80);

// Tampilan website modern dengan animasi ikon & badge status
