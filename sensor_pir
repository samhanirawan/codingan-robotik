#include <WiFi.h>
#include <WebServer.h>
#include <ESP32Servo.h>

// --- KONFIGURASI WI-FI ---
const char* ssid = "NAMA_WIFI_ANDA";
const char* password = "PASSWORD_WIFI_ANDA";

// --- KONFIGURASI PIN ---
const int SERVO_PIN = 13;
const int LDR_PIN = 34;
const int RELAY_PIN = 26;

// --- KONFIGURASI RELAY & SENSOR ---
// Ubah ke HIGH jika relay Anda bertipe Active HIGH
const int RELAY_ON = LOW;
const int RELAY_OFF = HIGH;

// Batas cahaya (0 = sangat gelap, 4095 = sangat terang pada modul LDR umum)
// Jika nilai pembacaan terbalik, sesuaikan logika < atau > di fungsi loop()
int batasGelap = 2200; 

// --- VARIABEL SISTEM ---
Servo servoPakan;
WebServer server(80);

bool modeOtomatis = true;
bool statusLampu = false;
int nilaiLDR = 0;

// --- HALAMAN WEB (HTML + CSS + JS) ---
