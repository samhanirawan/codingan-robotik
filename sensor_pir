// --- FUNGSI HANDLER WEB SERVER ---
void handleRoot() {
  server.send(200, "text/html", index_html);
}

void handleStatus() {
  bool isGelap = (nilaiLDR > batasGelap);
  String json = "{";
  json += "\"ldr\":" + String(nilaiLDR) + ",";
  json += "\"gelap\":" + String(isGelap ? "true" : "false") + ",";
  json += "\"lampu\":" + String(statusLampu ? "true" : "false") + ",";
  json += "\"auto\":" + String(modeOtomatis ? "true" : "false");
  json += "}";
  server.send(200, "application/json", json);
}

void handleLampu() {
  if (server.hasArg("state")) {
    String state = server.arg("state");
    if (state == "on") {
      modeOtomatis = false;
      statusLampu = true;
      digitalWrite(RELAY_PIN, RELAY_ON);
    } else if (state == "off") {
      modeOtomatis = false;
      statusLampu = false;
      digitalWrite(RELAY_PIN, RELAY_OFF);
    } else if (state == "auto") {
      modeOtomatis = true;
    }
  }
  server.send(200, "text/plain", "OK");
}

void handlePakan() {
  servoPakan.write(90);   // Buka katup pakan (sesuaikan sudut 0-180)
  delay(2000);            // Tahan selama 2 detik agar pakan turun
  servoPakan.write(0);    // Tutup kembali katup pakan
  server.send(200, "text/plain", "Pakan berhasil diberikan!");
}

void setup() {
  Serial.begin(115200);

  pinMode(RELAY_PIN, OUTPUT);
  digitalWrite(RELAY_PIN, RELAY_OFF);

  servoPakan.attach(SERVO_PIN);
  servoPakan.write(0); // Posisi awal katup tertutup

  // Koneksi ke Wi-Fi
  WiFi.begin(ssid, password);
  Serial.print("Menghubungkan ke Wi-Fi");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\nTerhubung! Buka IP berikut di browser:");
  Serial.println(WiFi.localIP());

  // Routing URL Web Server
  server.on("/", handleRoot);
  server.on("/status", handleStatus);
  server.on("/lampu", handleLampu);
  server.on("/pakan", handlePakan);

  server.begin();
}

void loop() {
  server.handleClient();

  // Baca sensor LDR
  nilaiLDR = analogRead(LDR_PIN);

  // Logika Otomatis Lampu Penghangat
  if (modeOtomatis) {
    if (nilaiLDR > batasGelap) {
      statusLampu = true;
      digitalWrite(RELAY_PIN, RELAY_ON);
    } else {
      statusLampu = false;
      digitalWrite(RELAY_PIN, RELAY_OFF);
    }
  }
}
