int led1=2;
int led2=3;
int led3=5;
int led4=6;
int led5=7;
int tombol=4;
int status=0;

void setup()
{
  pinMode(led1, OUTPUT);
  pinMode(led2, OUTPUT);
  pinMode(led3, OUTPUT);
  pinMode(led4, OUTPUT);
  pinMode(led5, OUTPUT);
  pinMode(tombol, INPUT_PULLUP);
}

void loop()
{
  status=digitalRead(tombol);
  
  if (status==LOW) {
      digitalWrite(led1,HIGH);
    delay(100);
      digitalWrite(led1,LOW);
    delay(100);
  } else {
      digitalWrite(led1,LOW);
  }
  
  
   if (status==LOW) {
      digitalWrite(led2,HIGH);
    delay(100);
      digitalWrite(led2,LOW);
    delay(100);
  } else {
      digitalWrite(led2,LOW);
  }
  
  
   if (status==LOW) {
      digitalWrite(led3,HIGH);
    delay(100);
      digitalWrite(led3,LOW);
    delay(100);
  } else {
      digitalWrite(led3,LOW);
  }
  
  
   if (status==LOW) {
      digitalWrite(led4,HIGH);
    delay(100);
      digitalWrite(led4,LOW);
    delay(100);
  } else {
      digitalWrite(led4,LOW);
  }
 
  
   if (status==LOW) {
      digitalWrite(led5,HIGH);
    delay(100);
      digitalWrite(led5,LOW);
    delay(100);
  } else {
      digitalWrite(led5,LOW);
  }
}
